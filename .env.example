# Copy to .env and fill in. .env is gitignored, so each machine keeps its own.
# config.py reads these; anything left unset falls back to the defaults in config.py.

# ---- Django ----
# Set on the dev PC; leave unset on the server.
DJANGO_DEVELOPMENT=1
# DJANGO_SECRET_KEY=

# ---- Which database ----
# 'dev' or 'prod'. If unset: dev when DJANGO_DEVELOPMENT is set, else prod.
NITWITCH_DB=dev

# Optional credential overrides (defaults already live in config.py):
# PROD_DB_NAME=nitwitch
# PROD_DB_USER=melon
# PROD_DB_PASSWORD=
# DEV_DB_NAME=nitwitch_dev
# DEV_DB_USER=postgres
# DEV_DB_PASSWORD=

# Postgres as seen from the server that hosts it (loopback there).
# REMOTE_DB_HOST=127.0.0.1
# REMOTE_DB_PORT=5432

# ---- Movienight Discord-bot database ----
# Same host/port as Nitwitch (tunnel-aware). Different DB name/user/password.
# Do NOT run Django migrations against this database.
# Role needs SELECT plus INSERT/UPDATE/DELETE on movies, ratings, endorsements,
# reviews, and INSERT/UPDATE on users/guilds (OAuth name upsert + site writes).
MOVIENIGHT_DB_NAME=movienight
MOVIENIGHT_DB_USER=your_movienight_user
MOVIENIGHT_DB_PASSWORD=your_movienight_password

# ---- Discord OAuth (Movienights viewer only) ----
# Discord Developer Portal → OAuth2: register BOTH redirects on the same app:
#   http://127.0.0.1:8000/movienights/oauth/discord/callback/
#   https://nitwitch.com/movienights/oauth/discord/callback/
# Redirect URI defaults from DJANGO_DEVELOPMENT (dev→127.0.0.1, prod→nitwitch.com).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=   # optional override

# ---- SSH tunnel ----
# THIS PC: set to 1 to reach the server's Postgres over SSH.
# SERVER: leave unset/0 so Django connects to local Postgres directly.
USE_SSH_TUNNEL=1

SSH_HOST=nitwitch.com
SSH_PORT=22
SSH_USER=your_ssh_user

# Auth: use a key (recommended) OR a password.
SSH_PKEY=~/.ssh/id_ed25519
# SSH_PKEY_PASSWORD=
# SSH_PASSWORD=

# ---- Outbound email (prod) ----
# Only used when DJANGO_DEVELOPMENT is unset (prod). Dev prints mail to console.
# Amazon SES SMTP — match EMAIL_HOST to your SES region. See README.
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_ses_smtp_username
EMAIL_HOST_PASSWORD=your_ses_smtp_password
DEFAULT_FROM_EMAIL=no-reply@nitwitch.com
